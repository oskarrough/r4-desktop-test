#!/usr/bin/env bash
# Build a relocatable app bundle; requires brew install mpv dylibbundler.
set -euo pipefail
cd "$(dirname "$0")/.."
stage="$PWD/target/package-macos"
app="$stage/Radio4000.app"
rm -rf "$stage"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Frameworks" "$app/Contents/Resources"
cp target/release/radio4000 "$app/Contents/MacOS/"
cat >"$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleName</key><string>Radio4000</string>
<key>CFBundleIdentifier</key><string>org.radio4000.desktop</string>
<key>CFBundleExecutable</key><string>radio4000</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleIconFile</key><string>radio4000</string>
<key>CFBundleVersion</key><string>1</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
PLIST
# iconutil reads only these sizes, each with an @2x.
iconset="$stage/radio4000.iconset"
mkdir -p "$iconset"
for size in 16 32 128 256 512; do
    sips -z $size $size assets/radio4000-macos.png --out "$iconset/icon_${size}x${size}.png" >/dev/null
    sips -z $((size * 2)) $((size * 2)) assets/radio4000-macos.png --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "$iconset" -o "$app/Contents/Resources/radio4000.icns"
dylibbundler -od -b -x "$app/Contents/MacOS/radio4000" \
    -d "$app/Contents/Frameworks" -p '@executable_path/../Frameworks/'
# dylibbundler points every rpath at Frameworks, and dyld refuses a library that lists one twice.
# libmpv's Swift rpaths collapse that way, so keep one and give back the system Swift runtime.
for library in "$app/Contents/Frameworks/"*.dylib; do
    rpaths=$(otool -l "$library" | grep -c 'path @executable_path/../Frameworks/ ' || true)
    if ((rpaths > 1)); then
        for ((i = 0; i < rpaths; i++)); do
            install_name_tool -delete_rpath '@executable_path/../Frameworks/' "$library"
        done
        install_name_tool -add_rpath '@executable_path/../Frameworks/' -add_rpath /usr/lib/swift "$library"
    fi
done
mkdir -p "$app/Contents/Resources/licenses"
# Homebrew keeps the licenses with each library's keg, not the linked dylib.
# One walk of the Cellar; searching it per library took over a minute.
dylibs=$(find "$(brew --cellar)" -name '*.dylib' -type f)
for library in "$app/Contents/Frameworks/"*.dylib; do
    name=$(basename "$library")
    original=$(grep -m1 "/$name\$" <<<"$dylibs" || true)
    if [[ -n "$original" ]]; then
        keg=${original%%/lib/*}
        find "$keg" -maxdepth 1 -type f \( -iname '*license*' -o -iname '*copying*' \) \
            -exec cp '{}' "$app/Contents/Resources/licenses/$name.txt" \;
    fi
done
# Ad-hoc signing allows relocated dylibs on Apple silicon. Distribution signing can replace this.
codesign --force --deep --sign - "$app"
"$app/Contents/MacOS/radio4000" --version
"$app/Contents/MacOS/radio4000" --check-playback
tar -czf target/radio4000-macos-arm64.tar.gz -C "$stage" Radio4000.app
