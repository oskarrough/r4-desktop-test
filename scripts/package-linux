#!/usr/bin/env bash
# Build an AppImage with libmpv and its transitive libraries. Run after cargo build --release.
set -euo pipefail
cd "$(dirname "$0")/.."
root=$PWD
stage="$root/target/package-linux"
rm -rf "$stage"
mkdir -p "$stage/AppDir/usr/bin" "$stage/downloads"
curl -fsSL -o "$stage/downloads/linuxdeploy" \
    https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage
chmod +x "$stage/downloads/linuxdeploy"
(cd "$stage/downloads" && ./linuxdeploy --appimage-extract >/dev/null)
linuxdeploy="$stage/downloads/squashfs-root"
"$linuxdeploy/AppRun" --appdir "$stage/AppDir" --executable "$root/target/release/radio4000" \
    --desktop-file "$root/assets/radio4000.desktop" --icon-file "$root/assets/radio4000.svg"
# AppImages deliberately use the host's desktop/driver libraries. Record exactly those packages
# for the clean-container smoke test, without accidentally installing a missing libmpv there.
if command -v dpkg-query >/dev/null; then
    # One dpkg-query for every library: each call reads the whole file database.
    ldd "$stage/AppDir/usr/bin/radio4000" | awk '$2 == "=>" && $3 ~ /^\// {print $3}' |
        grep -v "^$stage/" | xargs -r readlink -f | xargs -r dpkg-query -S 2>/dev/null |
        cut -d: -f1 | sort -u >"$stage/system-packages.txt" || true
    if grep -Eq 'mpv|yt-dlp|python' "$stage/system-packages.txt"; then
        echo 'Playback dependencies escaped the bundle' >&2
        exit 1
    fi
fi
# Keep the distro's notices for every bundled shared library, including mpv and FFmpeg.
licenses="$stage/AppDir/usr/share/doc/radio4000"
mkdir -p "$licenses"
packages=$(find "$stage/AppDir/usr/lib" -type f -name '*.so*' -printf '*/%f\n' |
    xargs -r dpkg-query -S 2>/dev/null | cut -d: -f1 | sort -u || true)
for package in $packages; do
    if [[ -f "/usr/share/doc/$package/copyright" ]]; then
        cp "/usr/share/doc/$package/copyright" "$licenses/$package.txt"
        dpkg-query -W -f='${binary:Package} ${Version}\n' "$package" >>"$licenses/packages.txt"
        dpkg-query -W -f='https://launchpad.net/ubuntu/+source/${source:Package}/${source:Version}\n' "$package" >>"$licenses/sources.txt"
    fi
done
if [[ -f "$licenses/sources.txt" ]]; then sort -u -o "$licenses/sources.txt" "$licenses/sources.txt"; fi
(
    cd "$stage"
    # The libraries are already deployed; only squash the AppDir into the AppImage.
    ARCH=x86_64 OUTPUT="$root/target/radio4000-x86_64.AppImage" \
        "$linuxdeploy/usr/bin/linuxdeploy-plugin-appimage" --appdir "$stage/AppDir"
)
# Preserve the installer's existing archive name. The direct AppImage is published too.
mkdir -p "$stage/archive"
cp target/radio4000-x86_64.AppImage "$stage/archive/radio4000.AppImage"
tar -czf target/radio4000-linux-x86_64.tar.gz -C "$stage/archive" radio4000.AppImage
# No FUSE requirement for the smoke test, or for installs through install.sh.
(cd "$stage" && "$root/target/radio4000-x86_64.AppImage" --appimage-extract >/dev/null)
"$stage/squashfs-root/AppRun" --version
XDG_STATE_HOME="$stage/smoke-state" "$stage/squashfs-root/AppRun" --check-playback
